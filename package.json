{
  "name": "revive",
  "version": "1.0.0",
  "private": true,
  "description": "Paste an abandoned GitHub repo. Revive tries to make it run again.",
  "scripts": {
    "dev": "node scripts/predev.mjs && next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/predev.mjs && next start",
    "setup": "npm install && node scripts/predev.mjs",
    "db:push": "prisma db push --skip-generate",
    "db:generate": "prisma generate",
    "fixtures:build": "node scripts/build-fixtures.mjs",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "fixtures:generate": "python scripts/gen_fixtures.py && python scripts/gen_fixtures_node.py && python scripts/gen_fixture_halfmigration.py && python scripts/fix_peer_fixture.py",
    "test:integration": "vitest run tests/integration.node.test.ts tests/integration.languages.test.ts",
    "test:all": "vitest run",
    "screens": "node scripts/capture-screens.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "archiver": "7.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "4.5.1",
    "lucide-react": "0.469.0",
    "next": "15.5.25",
    "next-themes": "0.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "semver": "7.6.3",
    "smol-toml": "1.3.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/archiver": "6.0.3",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@types/semver": "7.5.8",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
