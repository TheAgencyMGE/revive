# ---------------------------------------------------------------------------
# Revive runs with ZERO configuration. Every value below is optional.
# Copy to `.env` only if you want to change a default.
# ---------------------------------------------------------------------------

# SQLite database location. Default is a local file — no server required.
DATABASE_URL="file:./dev.db"

# Where cloned repositories and generated artifacts live.
# Defaults to `<project>/.revive` if unset.
# REVIVE_DATA_DIR="./.revive"

# Force a sandbox mode instead of auto-detecting Docker.
# One of: auto (default) | docker | restricted | analysis-only
# REVIVE_SANDBOX_MODE="auto"

# Resource ceilings for sandboxed repository execution.
# REVIVE_MAX_REPO_MB=512          # reject clones larger than this
# REVIVE_STEP_TIMEOUT_MS=300000   # per-command timeout (5 min)
# REVIVE_JOB_TIMEOUT_MS=1800000   # whole-job timeout (30 min)
# REVIVE_MAX_OUTPUT_BYTES=2000000 # per-command captured output cap
# REVIVE_CONTAINER_MEMORY="2g"
# REVIVE_CONTAINER_CPUS="2"
# REVIVE_MAX_CONCURRENT_JOBS=2

# ---------------------------------------------------------------------------
# AI is OPTIONAL. Revive performs full deterministic diagnosis and repair
# without it. Keys are normally supplied through the in-app settings dialog and
# stored in the browser only — they are never written to disk or logged.
# These server-side vars exist for self-hosted single-user deployments.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
